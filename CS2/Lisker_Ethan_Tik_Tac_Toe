def display_board(board):
    """
    Print the current board state in a clean, readable grid format 
    with row and column labels (1-3)
    """
    print("\n    1   2   3")
    for r in range(3):
        row_str = f"{r + 1}   " + " | ".join(board[r])
        print(row_str)
        if r < 2:
            print("   -----------")
    print()


def get_player_move(board, player):
    """
    Prompt the current player for row and column inputs (1-3).
    Validates that inputs are integers, within range, and targeting an empty space.
    Returns zero-based index tuple: (row_index, col_index)
    """
    while True:
        try:
            row_input = input(f"Player {player}, enter row (1-3): ").strip()
            col_input = input(f"Player {player}, enter column (1-3): ").strip()

            row = int(row_input) - 1
            col = int(col_input) - 1

            if not (0 <= row <= 2 and 0 <= col <= 2):
                print("\033[31mInvalid range! Row and column must be between 1 and 3.\033[0m\n")
                continue

            # Validate spot occupancy
            if board[row][col] != " ":
                print("\033[31mThat cell is already occupied! Choose an empty space.\033[0m\n")
                continue

            return row, col

        except ValueError:
            print("\033[31mInvalid input! Please enter whole numbers (1, 2, or 3).\033[0m\n")


def check_winner(board):
    """
    Check all 8 winning conditions (3 rows, 3 columns, 2 diagonals).
    Returns 'X', 'O', or None if there is no winner yet.
    """

    for row in board:
        if row[0] == row[1] == row[2] != " ":
            return row[0]

    for col in range(3):
        if board[0][col] == board[1][col] == board[2][col] != " ":
            return board[0][col]

    if board[0][0] == board[1][1] == board[2][2] != " ":
        return board[0][0]
    
    if board[0][2] == board[1][1] == board[2][0] != " ":
        return board[0][2]

    return None


def is_draw(board):
    """
    Return True if all cells are filled and there is no winner, otherwise False.
    """
    if check_winner(board) is not None:
        return False

    for row in board:
        for cell in row:
            if cell == " ":
                return False
                
    return True


def play_game():
    """
    Main game loop that initializes the board, allows Player 1 to choose X or O,
    alternates player turns, evaluates game termination (win/draw), and handles replaying.
    """

    while True:
        board = [[" " for _ in range(3)] for _ in range(3)]

        player_1_symbol = input("\nPlayer 1, enter your letter of choice (X or O): ").strip().upper()
        while player_1_symbol not in ["X", "O"]:
            print("\033[31mInvalid input! Please enter X or O.\033[0m")
            player_1_symbol = input("Player 1, enter your letter of choice (X or O): ").strip().upper()

        player_2_symbol = "O" if player_1_symbol == "X" else "X"
        print(f"Player 1 is '{player_1_symbol}' and Player 2 is '{player_2_symbol}'. Player 1 goes first!")

        current_player = player_1_symbol

        while True:
            display_board(board)

            # Get validated move and place spot on the board
            row, col = get_player_move(board, current_player)
            board[row][col] = current_player

            winner = check_winner(board)
            if winner is not None:
                display_board(board)
                print(f"\033[32mPlayer {winner} wins the game!\033[0m")
                break

            if is_draw(board):
                display_board(board)
                print(f"\033[31mGame over! It's a draw!\033[0m")
                break

            current_player = "O" if current_player == "X" else "X"

        # Ask to replay
        replay = input("\nWould you like to play again? (y/n): ").strip().lower()
        if replay not in ["y", "yes"]:
            print("\033[34m\nThanks for playing Tic-Tac-Toe! Goodbye!\033[0m")
            break


if 1 == 1:
    play_game()
